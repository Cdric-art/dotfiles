// Waybar — disposition reprise de la barre Omarchy, thème Ghost Pastel
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,

  "modules-left": ["custom/menu", "hyprland/workspaces"],
  "modules-center": ["clock", "mpris"],
  "modules-right": ["tray", "pulseaudio", "pulseaudio#mic", "cpu", "memory", "custom/power"],

  "custom/menu": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "persistent-workspaces": { "*": 3 },
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },

  "clock": {
    "locale": "fr_FR.UTF-8",
    "format": "{:%A %H:%M}",
    "format-alt": "{:%e %B S%V %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#cd9dcf'><b>{}</b></span>",
        "weeks": "<span color='#836f79'>S{}</span>",
        "weekdays": "<span color='#7c93dd'>{}</span>",
        "today": "<span color='#979fec'><b><u>{}</u></b></span>"
      }
    }
  },

  "mpris": {
    "format": " {artist} – {title}",
    "format-paused": " {artist} – {title}",
    "max-length": 50,
    "on-click": "playerctl play-pause"
  },

  "tray": { "icon-size": 14, "spacing": 8 },

  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) — {ipaddr}",
    "tooltip-format-ethernet": "{ifname} — {ipaddr}",
    "on-click": "kitty -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": { "default": ["", "", ""] },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc}"
  },

  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
    "tooltip-format": "{source_desc}"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 3,
    "on-click": "kitty -e btop"
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} Gio",
    "on-click": "kitty -e btop"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
