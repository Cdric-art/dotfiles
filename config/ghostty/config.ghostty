# Ghostty — mêmes réglages que kitty, thème Ghost Pastel (themes/Ghost)
theme = Ghost

font-family = "Fira Code"
font-size = 10

window-padding-x = 4
window-padding-y = 4

# Pas de barre de titre (comme kitty sous Hyprland) ; onglets aux couleurs du thème
window-decoration = none
window-theme = ghostty
