        "author": "Ghost Pastel palette — omarchytheme.com/themes/ghost-pastel"
    },
    "text-styles": {
        "Normal":         { "text-color": "#ffffff", "selected-text-color": "#070506" },
        "Keyword":        { "text-color": "#979fec", "selected-text-color": "#070506", "bold": true },
        "Function":       { "text-color": "#7c93dd", "selected-text-color": "#070506" },
        "Variable":       { "text-color": "#e4e6fb", "selected-text-color": "#070506" },
        "ControlFlow":    { "text-color": "#979fec", "selected-text-color": "#070506", "bold": true },
        "Operator":       { "text-color": "#c3cef2", "selected-text-color": "#070506" },
        "BuiltIn":        { "text-color": "#cd9dcf", "selected-text-color": "#070506" },
        "Extension":      { "text-color": "#7c93dd", "selected-text-color": "#070506" },
        "Preprocessor":   { "text-color": "#e095b5", "selected-text-color": "#070506" },
        "Attribute":      { "text-color": "#cd9dcf", "selected-text-color": "#070506" },
        "Char":           { "text-color": "#d5aeb5", "selected-text-color": "#070506" },
        "SpecialChar":    { "text-color": "#e095b5", "selected-text-color": "#070506" },
        "String":         { "text-color": "#a7c1e8", "selected-text-color": "#070506" },
        "VerbatimString": { "text-color": "#a7c1e8", "selected-text-color": "#070506" },
        "SpecialString":  { "text-color": "#e095b5", "selected-text-color": "#070506" },
        "Import":         { "text-color": "#cd9dcf", "selected-text-color": "#070506" },
        "DataType":       { "text-color": "#e095b5", "selected-text-color": "#070506" },
        "DecVal":         { "text-color": "#d5aeb5", "selected-text-color": "#070506" },
        "BaseN":          { "text-color": "#d5aeb5", "selected-text-color": "#070506" },
        "Float":          { "text-color": "#d5aeb5", "selected-text-color": "#070506" },
        "Constant":       { "text-color": "#d5aeb5", "selected-text-color": "#070506" },
        "Comment":        { "text-color": "#836f79", "selected-text-color": "#070506", "italic": true },
        "Documentation":  { "text-color": "#836f79", "selected-text-color": "#070506" },
        "Annotation":     { "text-color": "#cd9dcf", "selected-text-color": "#070506" },
        "CommentVar":     { "text-color": "#c3cef2", "selected-text-color": "#070506" },
        "RegionMarker":   { "text-color": "#7c93dd", "selected-text-color": "#070506", "background-color": "#1a1418" },
        "Information":    { "text-color": "#7c93dd", "selected-text-color": "#070506" },
        "Warning":        { "text-color": "#e095b5", "selected-text-color": "#070506" },
        "Alert":          { "text-color": "#070506", "selected-text-color": "#070506", "background-color": "#b37580", "bold": true },
        "Error":          { "text-color": "#b37580", "selected-text-color": "#070506", "underline": true },
        "Others":         { "text-color": "#c3cef2", "selected-text-color": "#070506" }
    },
    "editor-colors": {
        "BackgroundColor":            "#070506",
        "TextSelection":              "#979fec",
        "CurrentLine":                "#120e10",
        "SearchHighlight":            "#e095b5",
        "ReplaceHighlight":           "#cd9dcf",
        "BracketMatching":            "#2a2228",
        "TabMarker":                  "#2a2228",
        "IndentationLine":            "#2a2228",
        "WordWrapMarker":             "#2a2228",
        "SpellChecking":              "#b37580",
        "IconBorder":                 "#070506",
        "LineNumbers":                "#836f79",
        "CurrentLineNumber":          "#979fec",
        "Separator":                  "#1a1418",
        "CodeFolding":                "#1a1418",
        "MarkBookmark":               "#7c93dd",
        "MarkBreakpointActive":       "#b37580",
        "MarkBreakpointReached":      "#e095b5",
        "MarkBreakpointDisabled":     "#836f79",
        "MarkExecution":              "#648ed0",
        "MarkWarning":                "#e095b5",
        "MarkError":                  "#b37580",
        "ModifiedLines":              "#e095b5",
        "SavedLines":                 "#648ed0",
        "TemplateBackground":         "#120e10",
        "TemplatePlaceholder":        "#1a1418",
        "TemplateFocusedPlaceholder": "#2a2228",
        "TemplateReadOnlyPlaceholder":"#120e10"
    }
}
